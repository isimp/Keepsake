<Project>

  <!-- Shared by both assemblies: the plugin (src/Keepsake) and the preloader patcher
       (src/Keepsake.Preloader). The version lives here once for both. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>0.4.1</Version>
    <Authors>isimp</Authors>
    <Product>Keepsake</Product>
    <Copyright>Copyright (c) 2026 isimp</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <!-- Where the references come from. Two ways, because a machine with the game on it and a
       build server have nothing in common:

       Local:  a Valheim install and a BepInEx profile, and the build deploys into the profile
               when it finishes. Override either if yours differ.
                 dotnet build -p:ValheimDir=... -p:ProfileDir=...

       Anywhere else: one flat folder of DLLs. lib/ in this repository holds metadata-only
       copies, regenerated by tools/strip-references.ps1. Setting it touches nothing local,
       deploy included.
                 dotnet build -p:LibsDir=lib -->
  <PropertyGroup>
    <!-- -p:ValheimDir=... wins, then the VALHEIM_DIR environment variable, then a stock Steam
         install. Set VALHEIM_DIR once if your library lives on another drive. -->
    <ValheimDir Condition="'$(ValheimDir)' == '' And '$(VALHEIM_DIR)' != ''">$(VALHEIM_DIR)</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(AppData)\com.kesomannen.gale\valheim\profiles\Default</ProfileDir>
    <BepInExDir>$(ProfileDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <!-- A LibsDir given relative to the repository root is resolved against it, since each
       project builds from its own folder. -->
  <PropertyGroup Condition="'$(LibsDir)' != ''">
    <LibsPath>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '$(LibsDir)'))</LibsPath>
    <ManagedDir>$(LibsPath)</ManagedDir>
    <CoreDir>$(LibsPath)</CoreDir>
    <JotunnDir>$(LibsPath)</JotunnDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LibsDir)' == ''">
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <CoreDir>$(BepInExDir)\core</CoreDir>
    <JotunnDir>$(BepInExDir)\plugins\ValheimModding-Jotunn</JotunnDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Both assemblies carry the pins file and the cfg reader. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)src/Shared/**/*.cs" />
  </ItemGroup>

</Project>
